FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# TTS Provider Configuration
TTS_PROVIDER=google_gemini
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-google-api-key

# Database
DATABASE_URL=sqlite:///voiceforge.db
SQLALCHEMY_TRACK_MODIFICATIONS=False

# Audio Storage
AUDIO_STORAGE_PATH=./app/static/audio/projects
TEMP_AUDIO_PATH=./app/static/audio/temp

# Session Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Application
APP_NAME=VoiceForge
APP_SUBTITLE=AI Text-to-Speech Studio

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/voiceforge.log
